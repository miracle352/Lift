# Copy to .env.local and fill in. Never commit .env.local.

# ---------- Site ----------
APP_URL=http://localhost:3000
# Front end only (e.g. Vercel): proxy /api/* to the arena server
ARENA_API_ORIGIN=

# ---------- Tatum (dashboard.tatum.io, mainnet key) ----------
TATUM_API_KEY=
TATUM_SUI_GRPC_HOST=sui-mainnet-grpc.gateway.tatum.io:443
# Refuse Tatum calls past this many credits per UTC day
TATUM_DAILY_CREDIT_CAP=7000

# ---------- Walrus Memory (memory.walrus.xyz) ----------
# Delegate private key (hex or suiprivkey1...). Server only.
MEMWAL_PRIVATE_KEY=
# Walrus Memory account object id (0x..., not your wallet address)
MEMWAL_ACCOUNT_ID=
# Wallet address that owns the account; sealed blobs are sent here
MEMWAL_OWNER_ADDRESS=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# 1 = in-memory mock, no network
MEMWAL_MOCK=0

# ---------- Database ----------
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# ---------- Arena ----------
# Minutes between rounds (60 = one 15-minute window per hour)
ARENA_CADENCE_MIN=60
# Optional: from this ISO time on, use ARENA_SLOW_CADENCE_MIN instead
ARENA_SLOW_AFTER=
ARENA_SLOW_CADENCE_MIN=
# Lock the round this many minutes after the window opens
ARENA_LOCK_MINUTE=6
ARENA_ASSETS=btc,eth,sol,xrp,doge,bnb,hype,zec
# 1 = allow outside advisors on localhost (local demos only)
ARENA_ALLOW_LOCAL_ADVISORS=
# 0 = run rounds without payments
ARENA_PAYMENTS=1

# ---------- Payments (MPP, USDC on Sui) ----------
# 32+ random characters; binds MPP challenges to their contents
MPP_SECRET_KEY=
# One 32-byte hex secret derives every arena wallet (clearinghouse, agents, advisors). Server only.
ARENA_WALLET_SEED=
# testnet (faucet money, default) or mainnet
PAY_NETWORK=testnet
# Port of the worker's paid-takes endpoint; or point ARENA_TAKES_URL at the web app's
ARENA_PAY_PORT=8787
ARENA_TAKES_URL=
# Web app: where MPP payments for /api/arena/takes go (printed by `pnpm arena wallets`)
ARENA_CLEARINGHOUSE_ADDRESS=
