# Copy to .env.local (never commit it). `pnpm smoke:*` scripts and `pnpm dev` read .env.local.

# ---------- App ----------
APP_URL=http://localhost:3000
# 32+ random characters. PowerShell: -join ((48..57)+(97..122) | Get-Random -Count 40 | % {[char]$_})
SESSION_SECRET=
# 16+ random characters; GitHub Actions sends it to /api/cron/tick
CRON_SECRET=
# Comma-separated handles that may curate markets (e.g. miracle)
ADMIN_HANDLES=

# ---------- Tatum (dashboard.tatum.io -> API keys; use the MAINNET key) ----------
TATUM_API_KEY=
# Native gRPC gateway for Sui mainnet (default shown). Do not switch to JSON-RPC: it is deprecated.
TATUM_SUI_GRPC_HOST=sui-mainnet-grpc.gateway.tatum.io:443

# ---------- Walrus Memory (memory.walrus.xyz/dashboard) ----------
# Delegate PRIVATE key (hex or suiprivkey1...). Server only. Its PUBLIC key is the MEMWAL_AGENT_ID for the submission form.
MEMWAL_PRIVATE_KEY=
# Walrus Memory account object id (0x..., NOT your wallet address)
MEMWAL_ACCOUNT_ID=
# Wallet address that owns that account (the one you signed in with). Blob objects are sent here.
MEMWAL_OWNER_ADDRESS=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# 1 = in-memory mock (no network). Keep 0 for anything you want to count on mainnet.
MEMWAL_MOCK=0

# ---------- Database ----------
# Local dev: file:./local.db   Production (Turso): libsql://<db>-<org>.turso.io + token
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# ---------- Agent payments (milestone M7, optional) ----------
# 32+ random characters, binds MPP challenges to their contents
MPP_SECRET_KEY=
# Demo agent wallet that pays for takes (suiprivkey1...). Fund with a little SUI (gas) and USDC on Sui mainnet.
AGENT_WALLET_PRIVATE_KEY=
